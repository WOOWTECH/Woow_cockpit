# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=nextcloud MCP admin


[Container]
ContainerName=nextcloud-mcp-admin
Image=localhost/woow-mcp-admin:latest
Network=nextcloud-mcp-admin.network
PublishPort=127.0.0.1:18506:8080
Volume=nextcloud-mcp-admin.volume:/data
EnvironmentFile=%h/.config/nextcloud-mcp-admin/nextcloud-mcp-admin.env
Secret=nextcloud-mcp-admin-jwt-secret,type=env,target=JWT_SECRET
Secret=nextcloud-mcp-admin-password,type=env,target=ADMIN_PASSWORD
HealthCmd=wget -qO- http://127.0.0.1:8080/healthz

[Service]
Restart=always

[Install]
WantedBy=default.target
