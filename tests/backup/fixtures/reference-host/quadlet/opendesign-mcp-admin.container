# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=opendesign MCP admin


[Container]
ContainerName=opendesign-mcp-admin
Image=localhost/woow-mcp-admin:latest
Network=opendesign-mcp-admin.network
PublishPort=127.0.0.1:18507:8080
Volume=opendesign-mcp-admin.volume:/data
EnvironmentFile=%h/.config/opendesign-mcp-admin/opendesign-mcp-admin.env
Secret=opendesign-mcp-admin-jwt-secret,type=env,target=JWT_SECRET
Secret=opendesign-mcp-admin-password,type=env,target=ADMIN_PASSWORD
HealthCmd=wget -qO- http://127.0.0.1:8080/healthz

[Service]
Restart=always

[Install]
WantedBy=default.target
