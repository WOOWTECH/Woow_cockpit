# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=Hermes Redis


[Container]
ContainerName=hermes-redis
Image=docker.io/library/redis:7-alpine
Network=hermes.network
Volume=hermes-redis-data.volume:/data
Exec=redis-server --appendonly yes
HealthCmd=redis-cli ping

[Service]
Restart=always

[Install]
WantedBy=default.target
