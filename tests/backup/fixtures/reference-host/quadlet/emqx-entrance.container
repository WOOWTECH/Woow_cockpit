# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=EMQX management entrance (shares the broker network namespace)
Requires=emqx.service
After=emqx.service

[Container]
ContainerName=emqx-entrance
Image=docker.io/library/nginx:1.27-alpine
Network=container:emqx
Volume=%h/.config/emqx/entrance.conf:/etc/nginx/conf.d/default.conf:ro

[Service]
Restart=always

[Install]
WantedBy=default.target
