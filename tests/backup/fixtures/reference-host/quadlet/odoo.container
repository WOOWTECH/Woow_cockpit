# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=Odoo 18
Requires=odoo-db.service
After=odoo-db.service

[Container]
ContainerName=odoo18
Image=localhost/odoo-woow:18.0
Network=odoo.network
PublishPort=127.0.0.1:18069:8069
Volume=odoo-web-data.volume:/var/lib/odoo
Volume=%h/.local/share/odoo18/addons:/mnt/extra-addons:ro
Secret=odoo18-odoo-conf,type=mount,target=/etc/odoo/odoo.conf
HealthCmd=curl -fsS http://localhost:8069/web/health

[Service]
Restart=always

[Install]
WantedBy=default.target
