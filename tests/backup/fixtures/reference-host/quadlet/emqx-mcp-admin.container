# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=emqx MCP admin


[Container]
ContainerName=emqx-mcp-admin
Image=localhost/woow-mcp-admin:latest
Network=emqx-mcp-admin.network
PublishPort=127.0.0.1:18501:8080
Volume=emqx-mcp-admin.volume:/data
EnvironmentFile=%h/.config/emqx-mcp-admin/emqx-mcp-admin.env
Secret=emqx-mcp-admin-jwt-secret,type=env,target=JWT_SECRET
Secret=emqx-mcp-admin-password,type=env,target=ADMIN_PASSWORD
HealthCmd=wget -qO- http://127.0.0.1:8080/healthz

[Service]
Restart=always

[Install]
WantedBy=default.target
