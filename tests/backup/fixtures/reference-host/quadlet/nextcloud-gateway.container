# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=Nextcloud gateway (nginx)
Requires=nextcloud-app.service
After=nextcloud-app.service nextcloud-office.service

[Container]
ContainerName=nextcloud-gateway
Image=docker.io/library/nginx:1.27-alpine
Network=nextcloud.network
PublishPort=127.0.0.1:18081:80
Volume=%h/.local/share/nextcloud-office/html:/var/www/html:ro
Volume=%h/.config/nextcloud/gateway.conf:/etc/nginx/conf.d/default.conf:ro
HealthCmd=curl -fsS http://localhost/status.php

[Service]
Restart=always

[Install]
WantedBy=default.target
