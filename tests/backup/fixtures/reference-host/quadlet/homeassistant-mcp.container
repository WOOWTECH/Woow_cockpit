# Reference-host shape for catalog-suggest tests: names, mounts and dependencies only, no secret values.
[Unit]
Description=Home Assistant MCP
Requires=homeassistant.service
After=homeassistant.service

[Container]
ContainerName=homeassistant-mcp
Image=ghcr.io/homeassistant-ai/ha-mcp:latest
Network=host
Environment=HOMEASSISTANT_URL=http://127.0.0.1:8123
Secret=homeassistant-mcp-token,type=env,target=HOMEASSISTANT_TOKEN

[Service]
Restart=always

[Install]
WantedBy=default.target
