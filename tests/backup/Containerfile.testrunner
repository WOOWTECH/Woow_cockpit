# Test runner for the backup engine unit tests (team E1).
# Ubuntu 24.04 ships age 1.1.1, zstd, python3-nacl 1.5.0 and python3-cryptography 41.0.7, what production devices use
# (the last two read uploaded Home Assistant backups).
# Build only with the isolated lab storage:
#   ~/.woowbk-lab/bin/labpodman build --memory 512m -t localhost/woowbk-testrunner:noble \
#       -f tests/backup/Containerfile.testrunner tests/backup
FROM docker.io/library/ubuntu:24.04
RUN apt-get update \
 && apt-get install -y --no-install-recommends python3 python3-nacl python3-cryptography age zstd ca-certificates \
 && rm -rf /var/lib/apt/lists/*
