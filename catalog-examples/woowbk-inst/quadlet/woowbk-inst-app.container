# woowbk-inst application (rootless Quadlet template, lab fixture): the woowbk-demo notes app, connected like Nextcloud
# with a role the setup created (oc_admin) whose password lives only in the app's volume (config/dbpassword).
# It works after a restore only when the role, its password hash and its database came back.
[Unit]
Description=woowbk-inst application
Requires=woowbk-inst-db.service
After=woowbk-inst-db.service

[Container]
ContainerName=woowbk-inst-app
Image=localhost/woowbk-demo-app:1
Network=woowbk-inst.network
PublishPort=127.0.0.1:18092:8080
Volume=woowbk-inst-files:/data
Secret=woowbk-inst-app-key
Environment=DB_HOST=woowbk-inst-db DB_NAME=nextcloud DB_USER=oc_admin DB_PASSWORD_FILE=/data/config/dbpassword
Environment=APP_KEY_FILE=/run/secrets/woowbk-inst-app-key APP_TITLE=woowbk-inst
HealthCmd=python3 /app/app.py --healthcheck
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=30s
PodmanArgs=--memory 128m

[Service]
Restart=on-failure
TimeoutStartSec=300

[Install]
WantedBy=default.target
