#!/usr/bin/python3 -I
"""Root helper for the Cockpit backup page. Imports only from the root-owned library dir."""
import os
import stat
import sys

LIB = '/usr/local/lib/woowtech-cockpit-backup'


def trusted(path):
    st = os.lstat(path)
    return stat.S_ISDIR(st.st_mode) and st.st_uid == 0 and not st.st_mode & 0o022


if __name__ == '__main__':
    if os.geteuid() != 0:
        sys.stdout.write('{"ok": false, "error": {"code": "permission-denied", "message": "需要管理員權限。", "details": {}}}\n')
        sys.exit(1)
    if not (trusted(LIB) and trusted(os.path.join(LIB, 'woowbackup'))):
        sys.stdout.write('{"ok": false, "error": {"code": "internal-error", "message": "備份元件安裝不完整或權限不安全。", "details": {}}}\n')
        sys.exit(1)
    sys.path.insert(0, LIB)
    from woowbackup.cli import main
    sys.exit(main(sys.argv[1:]))
