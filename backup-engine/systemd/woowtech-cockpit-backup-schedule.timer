# Scheduled backups: check the schedule every 5 minutes (installed by scripts/manage.py; docs/backup/CONTRACT.md
# section 8). The schedule itself (days, time, apps) is /etc/woowtech-cockpit/backup/schedule.json; this timer only
# ticks. No Persistent=: a tick missed while the device was off is not replayed, the engine catches up the slot.
[Unit]
Description=WOOWTECH Cockpit scheduled backups (check every 5 minutes)

[Timer]
OnCalendar=*:0/5
AccuracySec=15s

[Install]
WantedBy=timers.target
